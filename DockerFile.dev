# This is a Dockerfile for development use of the searchgov-spider project
# All database and search engine setup must be done through associated projects

FROM python:3.12-slim
WORKDIR /usr/src/searchgov-spider
ENV PYTHONPATH=/usr/src/searchgov-spider
SHELL ["/bin/bash", "-c"]

# Ensure latest apt packages
RUN apt-get update && apt-get install -y \
    vim \
    curl \
    jq

# Install and cache libraries
COPY search_gov_crawler/requirements.txt ./search_gov_crawler/requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install -r search_gov_crawler/requirements.txt

# Install chromium
RUN playwright install chromium --with-deps

# Install NLTK packages
RUN python -m nltk.downloader popular punkt_tab punkt perluniprops nonbreaking_prefixes stopwords

# Copy project files
COPY . .
